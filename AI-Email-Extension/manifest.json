{
  "name": "Email Writer Assistent",
  "description": "AI-Powered email reply generator",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab","storage"],
  "host_permissions": [
  "http://localhost:8081/*",
  "*://mail.google.com/*"
],
  "action": {
    "default_titile": "Email Writer Assistent"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": ["*://mail.google.com/*"],
      "css":["content.css"],
      "run_at":"document_end"
    } 
  ],
  "web_accessible_resources": [
  {
    "resources": ["icons/*"],
    "matches": ["https://mail.google.com/*"]
  }
]
}